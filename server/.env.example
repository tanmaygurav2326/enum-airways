# ============================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values
# ============================================

# Application
NODE_ENV=development
PORT=5000

# Oracle Database
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1521/XEPDB1

# JWT Authentication
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=5h

# Frontend URL (used for CORS)
REACT_APP_URL=https://tanmaygurav2326.github.io/enum-airways

# API Base URL
API_BASE_URL=https://stations-running-vienna-people.trycloudflare.com/api/